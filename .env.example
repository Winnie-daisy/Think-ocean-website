# Think Ocean CIC website and CMS.
# Copy to .env and fill in. Never commit .env. See DEPLOYMENT.md.

APP_NAME="Think Ocean CIC"
# Use "production" on the live server.
APP_ENV=local
APP_KEY=
# Must be false in production.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_TIMEZONE=Europe/London

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Use "warning" or "error" in production.
LOG_LEVEL=debug

# MySQL / MariaDB is the intended database. (Local development may use
# DB_CONNECTION=sqlite with database/database.sqlite.)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=think_ocean
DB_USERNAME=think_ocean
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only).
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" works without a queue worker on shared hosting.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Outgoing email (password resets, contact form notifications).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.org"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Donations (Stripe Checkout). Use test keys (sk_test_...) until you are ready to take real payments.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
DONATION_CURRENCY=gbp
